{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Learning platform API for users, courses and progress",
        "title": "SteadyLearn API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/health": {
            "get": {
                "description": "Reports that the process is serving requests. Checks no dependencies.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/schemas.HealthSchema"
                        }
                    }
                }
            }
        },
        "/health/live": {
            "get": {
                "description": "Reports that the process is alive. Always 200 while the server is up, so a failure means the process should be restarted.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Liveness probe",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/schemas.HealthSchema"
                        }
                    }
                }
            }
        },
        "/health/ready": {
            "get": {
                "description": "Reports whether the service can serve traffic, verifying the database connection. Returns 503 when it is unavailable.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Readiness probe",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/schemas.ReadinessSchema"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/schemas.ReadinessSchema"
                        }
                    }
                }
            }
        },
        "/v1/catalog": {
            "get": {
                "description": "Every published course with the domains they belong to, in display order. Public, and the same for every caller. Served from a cache for up to ten minutes.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "catalog"
                ],
                "summary": "Get the catalog",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/schemas.CatalogSchema"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/v1/courses/{id}": {
            "get": {
                "description": "A published course with its syllabus, as a visitor who is not signed in sees it: a course that keeps its syllabus private lists each module's lesson count, and null for its lessons. Served from a cache for up to ten minutes.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "catalog"
                ],
                "summary": "Get a course",
                "parameters": [
                    {
                        "type": "string",
                        "example": "replication-consensus",
                        "description": "Course slug",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/schemas.CourseSchema"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/v1/users": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Create the local record for the authenticated Cognito user. Idempotent.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "users"
                ],
                "summary": "Setup user",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/schemas.UserSchema"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/v1/users/me": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Get the currently authenticated user with the identity provider's profile attached. Served from a cache for up to five minutes, so a change made in the user pool can take that long to show. A 404 means the user has not been set up yet.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "users"
                ],
                "summary": "Get current user",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/schemas.UserSchema"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "schemas.CatalogSchema": {
            "type": "object",
            "properties": {
                "courses": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/schemas.CourseSummarySchema"
                    }
                },
                "domains": {
                    "description": "Domains are those with at least one course in the catalog, in display order.",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/schemas.DomainSchema"
                    }
                }
            }
        },
        "schemas.CourseSchema": {
            "type": "object",
            "properties": {
                "breakIts": {
                    "description": "BreakIts are the failure modes the learner triggers in the simulations.",
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "Lost write",
                        "Stale read",
                        "Split brain"
                    ]
                },
                "description": {
                    "type": "string",
                    "example": "Quorums, elections and leases, and the trade-offs behind each one."
                },
                "domain": {
                    "type": "string",
                    "example": "dist"
                },
                "id": {
                    "type": "string",
                    "example": "replication-consensus"
                },
                "isFree": {
                    "type": "boolean",
                    "example": false
                },
                "isNew": {
                    "type": "boolean",
                    "example": false
                },
                "lessonCount": {
                    "type": "integer",
                    "example": 12
                },
                "level": {
                    "type": "string",
                    "enum": [
                        "foundational",
                        "intermediate",
                        "advanced"
                    ],
                    "example": "advanced"
                },
                "minutes": {
                    "description": "Minutes is the course's advertised length, which is more than the sum of\nits lessons: it includes time spent in the simulations.",
                    "type": "integer",
                    "example": 198
                },
                "modules": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/schemas.ModuleSchema"
                    }
                },
                "title": {
                    "type": "string",
                    "example": "Replication \u0026 consensus"
                }
            }
        },
        "schemas.CourseSummarySchema": {
            "type": "object",
            "properties": {
                "breakIts": {
                    "description": "BreakIts are the failure modes the learner triggers in the simulations.",
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "Lost write",
                        "Stale read",
                        "Split brain"
                    ]
                },
                "description": {
                    "type": "string",
                    "example": "Quorums, elections and leases, and the trade-offs behind each one."
                },
                "domain": {
                    "type": "string",
                    "example": "dist"
                },
                "id": {
                    "type": "string",
                    "example": "replication-consensus"
                },
                "isFree": {
                    "type": "boolean",
                    "example": false
                },
                "isNew": {
                    "type": "boolean",
                    "example": false
                },
                "lessonCount": {
                    "type": "integer",
                    "example": 12
                },
                "level": {
                    "type": "string",
                    "enum": [
                        "foundational",
                        "intermediate",
                        "advanced"
                    ],
                    "example": "advanced"
                },
                "minutes": {
                    "description": "Minutes is the course's advertised length, which is more than the sum of\nits lessons: it includes time spent in the simulations.",
                    "type": "integer",
                    "example": 198
                },
                "title": {
                    "type": "string",
                    "example": "Replication \u0026 consensus"
                }
            }
        },
        "schemas.DomainSchema": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "example": "dist"
                },
                "name": {
                    "type": "string",
                    "example": "Distributed systems"
                }
            }
        },
        "schemas.HealthSchema": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "ok"
                }
            }
        },
        "schemas.LessonSchema": {
            "type": "object",
            "properties": {
                "code": {
                    "description": "Code is the lesson's place in the syllabus: 2.3 is the third lesson of\nthe second module.",
                    "type": "string",
                    "example": "2.3"
                },
                "minutes": {
                    "type": "integer",
                    "example": 15
                },
                "steps": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "watch",
                            "read",
                            "build",
                            "trace",
                            "range",
                            "bet",
                            "break",
                            "postmortem"
                        ]
                    },
                    "example": [
                        "watch",
                        "read",
                        "range",
                        "bet"
                    ]
                },
                "title": {
                    "type": "string",
                    "example": "Sizing replicated storage"
                }
            }
        },
        "schemas.ModuleSchema": {
            "type": "object",
            "properties": {
                "lessonCount": {
                    "type": "integer",
                    "example": 4
                },
                "lessons": {
                    "description": "Lessons is null when the course keeps its syllabus private from visitors\nwho are not signed in.",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/schemas.LessonSchema"
                    }
                },
                "title": {
                    "type": "string",
                    "example": "Quorums"
                }
            }
        },
        "schemas.ReadinessSchema": {
            "type": "object",
            "properties": {
                "database": {
                    "type": "string",
                    "example": "ok"
                },
                "error": {
                    "type": "string"
                },
                "status": {
                    "type": "string",
                    "example": "ok"
                }
            }
        },
        "schemas.UserProfileSchema": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "example": "john@example.com"
                },
                "externalProvider": {
                    "description": "ExternalProvider is the federated identity the user signed in through, and\nis null for a user who signed up with a password.",
                    "type": "string",
                    "example": "Google"
                },
                "name": {
                    "type": "string",
                    "example": "John Doe"
                },
                "picture": {
                    "type": "string",
                    "example": "https://example.com/picture.png"
                }
            }
        },
        "schemas.UserSchema": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "example": "123e4567-e89b-12d3-a456-426614174000"
                },
                "profile": {
                    "description": "Profile is filled in by the /me endpoint, which caches the call to the user\npool that fills it, and left out of the plain reads of the local record.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/schemas.UserProfileSchema"
                        }
                    ]
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Enter your Bearer token in the format: Bearer {token}",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}