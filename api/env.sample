PORT=8080
DATABASE_URL=postgres://user:password@host:5432/steadylearn
# Read-through cache; rediss:// for TLS. Every key is namespaced under steadylearn:
# and expires, so the instance can be shared with other services.
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
# Billing through Creem. Optional: leave these empty and billing is off, its
# endpoints answer 503. Test mode is the default; live is https://api.creem.io/v1
# and needs the live key, webhook secret and product.
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_ID=
CREEM_API_URL=https://test-api.creem.io/v1
# Where Creem sends a member back to after checkout.
APP_URL=http://localhost:5173
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=steadylearn-api
# SigNoz Cloud; for self-hosted SigNoz use its OTLP/HTTP address (http://<host>:4318)
# and drop the header.
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.<region>.signoz.cloud:443
OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=<your-ingestion-key>
DEPLOYMENT_ENVIRONMENT=development
