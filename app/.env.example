# Copy to .env.local and fill in the Cognito values for your environment.

# --- API -------------------------------------------------------------------
# The steadylearn API, without a trailing slash. Its CORS_ALLOWED_ORIGINS has
# to include the origin the app is served from.
VITE_API_URL=http://localhost:8080

# --- AWS Cognito -----------------------------------------------------------
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=
# Hosted UI domain, without https://. Needed for "Continue with Google".
VITE_USER_POOL_DOMAIN=

# Comma-separated; each must be registered as a callback / sign-out URL on the
# app client in Cognito.
VITE_COGNITO_OAUTH_REDIRECT_SIGN_IN=http://localhost:4173/external-auth
VITE_COGNITO_OAUTH_REDIRECT_SIGN_OUT=http://localhost:4173/login
